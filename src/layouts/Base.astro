---
import '../styles/global.css';
import '../styles/upgrade.css';
import '../styles/polish.css';
import '../styles/pages.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyDialog from '../components/PrivacyDialog.astro';
import { site } from '../data/site';
import { createHash } from 'node:crypto';

// The only two inline scripts on the site. The security policy below allows exactly these
// (by their SHA-256 fingerprint) plus the site's own files, and nothing else.
const INLINE_VT = "(function(){var q=function(t){if(!t)return;['ready','finished','updateCallbackDone'].forEach(function(k){t[k]&&t[k].catch(function(){})});if(matchMedia('(prefers-reduced-motion: reduce)').matches)try{t.skipTransition()}catch(e){}};addEventListener('pagereveal',function(e){q(e.viewTransition)});addEventListener('pageswap',function(e){q(e.viewTransition)});addEventListener('unhandledrejection',function(e){var r=e.reason;if(r&&r.name==='InvalidStateError'&&/transition/i.test(r.message||''))e.preventDefault()})})();";
const INLINE_JS = "document.documentElement.classList.add('js');setTimeout(function(){var r=document.documentElement;if(!r.classList.contains('motion-on'))r.classList.remove('js')},3000);";
const sha = (code: string) => `'sha256-${createHash('sha256').update(code, 'utf8').digest('base64')}'`;
const csp = [
  "default-src 'self'",
  `script-src 'self' ${sha(INLINE_VT)} ${sha(INLINE_JS)}`,
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob:",
  "font-src 'self'",
  "connect-src 'self'",
  "frame-src 'none'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
  'upgrade-insecure-requests',
].join('; ');

interface Props {
  title: string;
  description: string;
  page: string;
  /** Pages driven by the original scripts (careers, apply, track) wire their own menu and dialogs. */
  legacy?: boolean;
  noindex?: boolean;
  privacyLinkId?: string;
  privacyTarget?: string;
  bodyClass?: string;
}
const { title, description: fullDescription, page, legacy = false, noindex = false, privacyLinkId, privacyTarget, bodyClass } = Astro.props;
// search results show about 160 characters: keep descriptions within that, cut at a word
const description = fullDescription.length <= 158 ? fullDescription : fullDescription.slice(0, 155).replace(/[\s,.;:]+\S*$/, '') + '…';
const ogImage = `${site.url}/assets/markforth-social.png`;
const canonical = new URL(Astro.url.pathname === '/index.html' ? '/' : Astro.url.pathname, site.url).href;
const fullTitle = page === 'home' ? `${site.name} | Built to move business forward` : `${title} | ${site.name}`;
// Structured data (schema.org) for search engines. Not visible on the page.
const orgId = `${site.url}/#organization`;
const organization = {
  '@type': 'Organization', '@id': orgId, name: site.legalName, alternateName: site.name, url: site.url,
  logo: `${site.url}/android-chrome-512x512.png`, email: site.email, ...(site.phone ? { telephone: site.phone } : {}),
  address: { '@type': 'PostalAddress', streetAddress: 'Office No. 04-05, 1st Floor, Burj-e-Noor Trading Center, Main Murree Road', addressLocality: 'Rawalpindi', postalCode: '43490', addressCountry: 'PK' },
  sameAs: site.socials.map((s) => s.href),
};
const pathName = Astro.url.pathname.replace(/\.html$/, '');
const sections: Record<string, { name: string; href: string }> = {
  services: { name: 'Services', href: `${site.url}/services.html` },
  campaigns: { name: 'Campaigns', href: `${site.url}/campaigns.html` },
};
const [, first = '', second] = pathName.split('/');
const crumbs = [{ name: 'Home', item: `${site.url}/` }];
if (second && sections[first]) crumbs.push({ name: sections[first].name, item: sections[first].href });
crumbs.push({ name: title, item: canonical });
const ld = noindex || page === '404' ? null : JSON.stringify(page === 'home' ? {
  '@context': 'https://schema.org',
  '@graph': [organization, { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': orgId } }],
} : {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': first === 'about' ? 'AboutPage' : first === 'contact' ? 'ContactPage' : 'WebPage', '@id': `${canonical}#webpage`, url: canonical, name: fullTitle, description, isPartOf: { '@id': `${site.url}/#website` }, publisher: { '@id': orgId } },
    { '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })) },
    ...(second && sections[first] ? [{ '@type': 'Service', name: title, description, url: canonical, serviceType: title, areaServed: 'US', provider: organization }] : []),
  ],
});
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="Content-Security-Policy" content={csp} />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <script is:inline set:html={INLINE_VT}></script>
  <script is:inline set:html={INLINE_JS}></script>
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#07080b" />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  {page !== '404' && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Markforth Solutions (Private) Limited: built to move business forward" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/assets/fonts/cabinet-grotesk-700.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
  {ld && <script type="application/ld+json" set:html={ld} />}
  <slot name="head" />
</head>
<body data-page={page} data-legacy={legacy ? '' : undefined} class={bodyClass}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer privacyLinkId={privacyLinkId} privacyTarget={privacyTarget} managedPrivacy={!privacyTarget} />
  {!privacyTarget && (
    <PrivacyDialog />
  )}
  <slot name="end" />
  <script>
    import { boot } from '../scripts/main';
    boot();
  </script>
</body>
</html>
