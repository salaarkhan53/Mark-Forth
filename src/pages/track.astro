---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import '../styles/legacy.css';
// Tracking and interview booking markup from the live site, unchanged, for /tracking.js,
// /booking.js, /api/track.php and /api/booking.php. Only the styling is new.
---
<Base title="Track your application" page="track" legacy noindex privacyLinkId="privacy-link" privacyTarget="tracking-privacy" bodyClass="tracking-page" description="Verify your email to securely view your Markforth application status and published interview instructions.">
  <PageHero
    label="Application tracking"
    title="Your application."
    accent="A clearer next step."
    lead="Use your application reference and the email you applied with. Verify a one-time code to view updates published by the recruitment team."
    crumbs={[{ label: 'Careers', href: '/careers.html' }, { label: 'Track' }]}
    secondary={{ label: 'Open positions', href: '/careers.html' }}
    badge={{ icon: 'lock', title: 'Private and verified', text: 'One-time code sent to your email' }}
  />
<section class="container tracking-shell"><noscript><p class="track-note">Enable JavaScript to request and verify an email code. For help, contact info@markforthsol.com.</p></noscript><p id="tracking-note" class="track-note" role="status" hidden></p><div class="tracking-grid" id="tracking-grid"><aside class="tracking-help"><h2>A simple, private check-in.</h2><ol><li>Enter the reference shown on your submission receipt and your application email.</li><li>Check that inbox for a six-digit verification code. It expires in 10 minutes.</li><li>View your published status and any interview instructions shared by HR.</li></ol><p>Use the same browser tab to request and enter the code. Verified access expires after 30 minutes.</p><p>Need help or lost your reference?<br><a href="mailto:info@markforthsol.com">info@markforthsol.com ↗</a></p></aside><div><form id="track-request" class="tracking-form" method="post" action="/api/track.php"><h2>Find your application.</h2><label>Application reference<input name="reference" required maxlength="40" placeholder="MF-A-YYYYMMDD-XXXXXXXXXX" autocomplete="off" spellcheck="false"></label><label>Application email<input type="email" name="email" required maxlength="200" autocomplete="email" placeholder="you@example.com"></label><button class="button" type="submit">Send verification code ↗</button><p>No account or password is required. The code is sent only when the details match an application.</p></form><form id="track-verify" class="tracking-form" method="post" action="/api/track.php" hidden><h2>Check your inbox.</h2><p>Enter the six-digit code from Markforth. Check spam too. If it doesn’t arrive, confirm your details or contact the team.</p><label>Verification code<input class="code-input" name="code" required pattern={"[0-9]{6}"} maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="000000"></label><button class="button" type="submit">View my application ↗</button><div class="form-actions"><button id="resend-code" class="plain-button" type="button">Resend code</button><button id="change-details" class="plain-button" type="button">Change details</button></div></form></div></div><section id="tracking-status" class="tracking-status" hidden><article class="tracking-card"><span class="status-label">APPLICATION UPDATE</span><h2 id="public-status" tabindex="-1"></h2><div class="tracking-meta"><div id="tracking-reference"></div><div id="tracking-role"></div><div id="tracking-updated"></div></div><p class="applicant-message" id="public-message"></p><section class="track-interview" id="tracking-interview" hidden><h3>Your interview</h3><dl><div class="full"><dt>Date & time</dt><dd id="interview-time"></dd></div><div><dt>Duration</dt><dd id="interview-duration"></dd></div><div><dt>Mode</dt><dd id="interview-mode"></dd></div><div class="full"><dt>Location / meeting link</dt><dd id="interview-location"></dd></div></dl></section><section class="booking-panel" id="booking-panel" hidden aria-labelledby="booking-title"><p class="status-label">YOUR NEXT CONVERSATION</p><h3 id="booking-title">Choose an interview time.</h3><p id="booking-note" role="status"></p><div id="booking-current"></div><form id="booking-form" hidden><label for="booking-slot">Available times · Pakistan time (PKT)</label><select id="booking-slot" name="slot" required></select><button class="button" type="submit">Confirm interview booking ↗</button></form><div class="booking-controls"><button id="booking-cancel" type="button" hidden>Cancel my booking</button><button id="booking-refresh" type="button">Refresh available times ↻</button></div><p class="track-small">Booking changes close one hour before the interview. Contact info@markforthsol.com for help.</p></section></article><div class="tracking-actions"><button id="refresh-status" type="button">Refresh update ↻</button><button id="tracking-logout" type="button">Sign out of tracking</button></div><p class="track-small">This page shows updates published by HR. For questions about your application, contact info@markforthsol.com and include your reference.</p></section></section>
  <Fragment slot="end">
<dialog id="tracking-privacy"><h2>Application tracking privacy</h2><p>Your reference and email are used to verify access to your application. Verification codes expire after 10 minutes; a verified session lasts 30 minutes. Attempts are limited to protect access. Private HR notes, salary details, CVs and other applicants are not included in the tracking response.</p><button class="btn btn-dark" type="button" id="close-tracking-privacy">Close ×</button></dialog>
    <script is:inline src="/forms-api.js"></script>
    <script is:inline src="/tracking.js"></script>
    <script is:inline src="/booking.js"></script>
  </Fragment>
</Base>
