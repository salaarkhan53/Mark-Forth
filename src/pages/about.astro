---
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Approach from '../components/Approach.astro';
import ProcessTeaser from '../components/ProcessTeaser.astro';
import CtaBand from '../components/CtaBand.astro';

// The motto, spelt out. Every line comes from what the site already says about how we work.
const motto = [
  { word: 'People', icon: 'users', text: 'A dedicated team, assigned to your work and trained on your process.', pts: ['Dedicated teams', 'Trained on your process', 'Working US business hours'] },
  { word: 'Process', icon: 'layers', text: 'Requirements agreed before launch, and every handoff follows the workflow you defined.', pts: ['Criteria agreed first', 'Documented handoffs', 'Private, secure records'] },
  { word: 'Progress', icon: 'chart', text: 'Feedback reviewed together, so the work keeps improving as your priorities change.', pts: ['Regular reviews', 'Adapt as you grow', 'One line of contact'] },
];
// 24 hour dial: tick marks and the four labels
const ticks = Array.from({ length: 24 }, (_, h) => h);
const label = (h: number) => (h === 0 ? '12 am' : h === 6 ? '6 am' : h === 12 ? '12 pm' : '6 pm');
---
<Base title="About" page="about" description="Markforth Solutions (Private) Limited is a BPO and lead generation company in Shamsabad, Rawalpindi. People, process and progress: how we work with partners.">
  <PageHero
    label="About Markforth"
    title="People. Process."
    accent="Progress."
    lead="A BPO and lead generation team in Shamsabad, Rawalpindi, working US business hours for the partners we support. Three words describe how we work."
    crumbs={[{ label: 'About' }]}
    action={{ label: 'Work with us', href: '/contact.html' }}
    secondary={{ label: 'Join the team', href: '/careers.html' }}
    variant="map"
  >
    <div class="bridge" slot="aside">
      <svg class="bridge__map" viewBox="0 0 420 240" aria-hidden="true">
        <defs>
          <pattern id="bridge-dots" width="12" height="12" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.1" /></pattern>
          <linearGradient id="bridge-line" x1="0" x2="1"><stop offset="0" stop-color="#ff4b2b" /><stop offset="1" stop-color="#ffffff" stop-opacity="0.7" /></linearGradient>
        </defs>
        <rect class="bridge__dots" width="420" height="240" fill="url(#bridge-dots)" />
        <path class="bridge__arc" d="M330 150 C 290 30, 130 20, 78 112" pathLength="1" stroke="url(#bridge-line)" />
        <g class="bridge__pin bridge__pin--home" transform="translate(330 150)">
          <circle class="bridge__pulse" r="16" /><circle r="6" />
          <path d="M0-30c-7.2 0-13 5.6-13 12.6C-13-8-0 4 0 4s13-12 13-21.4C13-24.4 7.2-30 0-30z" transform="translate(0 -6)" />
        </g>
        <g class="bridge__pin bridge__pin--us" transform="translate(78 112)"><circle class="bridge__pulse" r="12" /><circle r="5" /></g>
        <text x="330" y="186" text-anchor="middle">Rawalpindi</text>
        <text x="78" y="140" text-anchor="middle">New York</text>
      </svg>
      <div class="bridge__clocks">
        <div data-clock="Asia/Karachi"><small>Our office</small><b class="num" data-time data-time-fx>PKT</b><span>Rawalpindi, <span data-day>today</span></span></div>
        <div data-clock="America/New_York"><small>Your customers</small><b class="num" data-time data-time-fx>ET</b><span>New York, <span data-day>today</span></span></div>
      </div>
    </div>
  </PageHero>

  <!-- People. Process. Progress. Three panels; the one you point at, tap or reach opens wide. -->
  <section class="band-void section rel slant-top motto" aria-labelledby="motto-title">
    <div class="container">
      <div class="motto__head" data-reveal>
        <p class="eyebrow" data-r>What we stand for</p>
        <h2 class="h2" id="motto-title" data-split>Three words, <span class="accent">every engagement.</span></h2>
      </div>
      <div class="motto__panels" data-motto>
        {motto.map((m, i) => (
          <article class:list={['motto__p', { 'is-open': i === 0 }]} tabindex="0" aria-labelledby={`motto-${i}`} style={`--i:${i}`}>
            <span class="motto__bars" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="motto__icon" aria-hidden="true"><Icon name={m.icon} /></span>
            <span class="motto__n" aria-hidden="true">0{i + 1}</span>
            <h3 class="motto__w" id={`motto-${i}`}>{m.word}.</h3>
            <div class="motto__more">
              <p>{m.text}</p>
              <ul>{m.pts.map((p) => <li><Icon name="check" />{p}</li>)}</ul>
            </div>
            <span class="motto__timer" aria-hidden="true"><i></i></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band-mist section" aria-label="The Markforth approach">
    <div class="container"><Approach /></div>
  </section>

  <!-- A 24 hour dial in Rawalpindi time: our shift, daylight here, and the hand at now -->
  <section class="band-void section dial-band" aria-labelledby="dial-title">
    <div class="container dial-grid">
      <div class="dial-copy" data-reveal>
        <p class="eyebrow" data-r>Time zones</p>
        <h2 class="h2" id="dial-title" data-split>Our day runs on <span class="accent">your clock.</span></h2>
        <p class="lede" data-r>When your customers are awake, our team is at work. The dial is a full day in Rawalpindi: the red arc is our US-hours shift, the hand is right now.</p>
        <ul class="dial-key" data-r>
          <li><i class="k-shift"></i><span><b>Our shift</b> 9 am Eastern to 5 pm Pacific, in Rawalpindi time</span></li>
          <li><i class="k-day"></i><span><b>Daylight in Rawalpindi</b> 6 am to 6 pm</span></li>
          <li><i class="k-now"></i><span><b>Now</b> <span data-dial-now>Rawalpindi time</span></span></li>
        </ul>
        <p class="dial-ahead" data-r><b class="num"><span data-hours>10</span></b><span>hours ahead of New York today, updated with daylight saving</span></p>
      </div>
      <div class="dial" data-dial data-r>
        <svg viewBox="0 0 360 360" aria-hidden="true">
          <circle class="dial__face" cx="180" cy="180" r="150" />
          {ticks.map((h) => <line class:list={['dial__tick', { 'is-major': h % 6 === 0 }]} x1="180" y1={h % 6 === 0 ? 34 : 40} x2="180" y2="48" transform={`rotate(${h * 15} 180 180)`} />)}
          {[0, 6, 12, 18].map((h) => {
            const a = (h / 24) * Math.PI * 2 - Math.PI / 2;
            return <text class="dial__label" x={180 + Math.cos(a) * 112} y={184 + Math.sin(a) * 112} text-anchor="middle">{label(h)}</text>;
          })}
          <circle class="dial__day" cx="180" cy="180" r="128" pathLength="24" transform="rotate(-90 180 180)" stroke-dasharray="12 12" stroke-dashoffset="-6" />
          <circle class="dial__track" cx="180" cy="180" r="140" />
          <circle class="dial__shift" cx="180" cy="180" r="140" pathLength="24" transform="rotate(-90 180 180)" data-dial-shift stroke-dasharray="11 13" stroke-dashoffset="-18" />
          <g class="dial__hand" data-dial-hand><line x1="180" y1="62" x2="180" y2="22" /><circle cx="180" cy="40" r="7" /></g>
        </svg>
        <div class="dial__center" data-shift>
          <small>Rawalpindi</small>
          <b class="num" data-clock="Asia/Karachi"><span data-time data-time-fx>PKT</span></b>
          <span class="dial__state" data-status-text>Our team works US business hours</span>
        </div>
      </div>
    </div>
  </section>

  <section class="band-light section" aria-labelledby="process-title">
    <div class="container">
      <ProcessTeaser label="From introduction to execution" title="Who does what," accent="settled before work begins." lead="Every partnership moves through the same four steps, so responsibilities are clear on both sides from day one." />
    </div>
  </section>

  <section class="band-mist section" aria-labelledby="office-title">
    <div class="container">
      <div class="split">
        <div class="photo-wrap office-card" data-pop>
          <Photo name="office-windows" sizes="(max-width: 900px) 100vw, 45vw" />
          <!-- the building's lift display climbs to our floor -->
          <div class="lift" data-lift aria-hidden="true">
            <span class="lift__floor"><em data-lift-floor>G</em><i class="lift__arrow"></i></span>
            <span class="lift__text"><small>Burj-e-Noor Trading Center</small><b>1st Floor · Office 04–05</b><span>Markforth Solutions</span></span>
            <span class="lift__dots"><i></i><i></i><i></i></span>
          </div>
        </div>
        <div class="split__body" data-reveal>
          <p class="eyebrow" data-r>Visit us</p>
          <h2 class="h2" id="office-title" data-split>Find us on <span class="accent">Murree Road.</span></h2>
          <p class="lede" data-r>Our team works from Burj-e-Noor Trading Center on Main Murree Road, in the heart of Shamsabad.</p>
          <dl class="facts" data-r>
            <div><dt><Icon name="briefcase" /> Office</dt><dd>No. 04-05, 1st Floor</dd></div>
            <div><dt><span class="pin-drop"><Icon name="pin" /></span> Area</dt><dd>Shamsabad, Rawalpindi 43490</dd></div>
            <div data-clock="Asia/Karachi"><dt><Icon name="clock" /> Local time</dt><dd><span data-time>Pakistan time</span>, <span data-day>today</span></dd></div>
            <div><dt><Icon name="phone" /> Call or WhatsApp</dt><dd><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></dd></div>
          </dl>
          <div class="hero__actions" data-r>
            <a class="btn btn-dark" href={site.address.mapUrl} target="_blank" rel="noopener"><Icon name="pin" /> Open in Google Maps</a>
            <a class="btn btn-line" href="/contact.html">Contact us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title="Work with the team" accent="behind the work." text="Partner with us on a campaign or an operation, or join the team in Rawalpindi." action={{ label: 'Work with us', href: '/contact.html' }} />
</Base>
