---
// Only facts we have: services, campaigns, roles (updated from the live job list), US time zones, hours ahead of New York.
---
<section class="band-void" aria-label="Markforth at a glance">
  <div class="container">
    <div class="stats" data-reveal>
      <div class="stat" data-r><b class="num"><span data-count="3">3</span></b><span>Core services</span></div>
      <div class="stat" data-r><b class="num"><span data-count="6">6</span></b><span>Campaigns supported</span></div>
      <div class="stat" data-r><b class="num"><span data-count="21" data-roles>21</span></b><span>Roles we recruit for</span></div>
      <div class="stat" data-r><b class="num"><span data-count="4">4</span></b><span>US time zones covered</span></div>
      <div class="stat" data-r><b class="num"><span data-count="10" data-hours>10</span><small>hrs</small></b><span>Ahead of New York today<span class="live-tag"><i aria-hidden="true"></i>Live</span></span></div>
    </div>
  </div>
</section>
