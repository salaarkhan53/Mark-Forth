---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { principles } from '../data/site';
interface Props { title?: string; }
const { title = 'Progress starts with people who' } = Astro.props;
---
<div class="approach">
  <div class="approach__copy" data-reveal>
    <p class="eyebrow" data-r>The Markforth approach</p>
    <h2 class="h2" data-split>{title} <span class="accent">take ownership.</span></h2>
    <p class="lede" data-r>Markforth Solutions (Private) Limited is a BPO and lead generation company based in Rawalpindi, Pakistan. We bring people and processes together to support the work behind business growth.</p>
    <figure class="approach__photo" data-r>
      <Photo name="meeting-notes" sizes="(max-width: 900px) 100vw, 45vw" />
      <figcaption><span class="approach__mark" aria-hidden="true"><i></i><i></i><i></i></span>People. Process. Progress.</figcaption>
    </figure>
  </div>
  <div class="principles" data-reveal>
    {principles.map((p, i) => (
      <div class="card hoverable" data-r>
        <span class="card__num">0{i + 1}</span>
        <div style="display:grid;gap:8px"><h3>{p.title}</h3><p>{p.text}</p></div>
      </div>
    ))}
    <div class="card hoverable" data-r>
      <span class="ibox"><Icon name="clock" /></span>
      <div style="display:grid;gap:8px">
        <h3>Working your hours.</h3>
        <p>Our team works US business hours from Rawalpindi, so your customers reach people while they are awake.</p>
        <a class="link" href="/#coverage-title">See the live time zones <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</div>
