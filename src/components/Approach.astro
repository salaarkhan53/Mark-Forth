---
// The Markforth approach: heading, counter and a photo on the left, as tall as the principles
// on the right; the principle in the middle of the screen lights up and the counter follows.
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { principles } from '../data/site';
interface Props { title?: string; }
const { title = 'Progress starts with people who' } = Astro.props;
const items = [
  ...principles.map((p, i) => ({ ...p, icon: ['target', 'layers', 'message'][i] })),
  { title: 'Working your hours.', text: 'Our team works US business hours from Rawalpindi, so your customers reach people while they are awake.', icon: 'clock' },
];
---
<div class="ap" data-ap>
  <div class="ap__side">
    <div class="ap__sticky" data-reveal>
      <p class="eyebrow" data-r>The Markforth approach</p>
      <h2 class="h2" data-split>{title} <span class="accent">take ownership.</span></h2>
      <p class="lede" data-r>Four habits shape every engagement, from the first call to the weekly review.</p>
      <div class="ap__meter" data-r aria-hidden="true">
        <span class="ap__count"><b data-ap-count>01</b><small>/ 0{items.length}</small></span>
        <span class="ap__track"><i data-ap-bar></i></span>
      </div>
      <a class="link" href="/#coverage-title" data-r>See the live time zones <Icon name="arrow" /></a>
      <figure class="ap__photo" data-r><Photo name="meeting-notes" sizes="(max-width: 900px) 100vw, 40vw" /></figure>
    </div>
  </div>
  <ol class="ap__list">
    {items.map((p, i) => (
      <li class:list={['ap__item', { 'is-active': i === 0 }]} data-ap-item style={`--i:${i}`}>
        <span class="ap__n" aria-hidden="true">0{i + 1}</span>
        <span class="ap__icon" aria-hidden="true"><Icon name={p.icon} /></span>
        <div class="ap__body">
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
        <span class="ap__line" aria-hidden="true"></span>
      </li>
    ))}
  </ol>
</div>
