---
import Icon from './Icon.astro';
import Emblem from './Emblem.astro';
const marquee = ['Lead generation', 'Customer support', 'Business process outsourcing', 'Medicare', 'ACA', 'Final Expense', 'Auto Insurance', 'Hospital Indemnity', 'Home Improvement'];
---
<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="mesh" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="slashes" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 class="display" id="hero-title" data-headline>Built to move business <span class="accent">forward.</span></h1>
      <p class="lede">The right conversations. The right support. Outsourcing solutions that help your business take its next step, from our team in Rawalpindi, Pakistan.</p>
      <div class="hero__actions" data-stage>
        <a class="btn btn-primary" href="/contact.html" data-magnetic>Build with Markforth <Icon name="arrow" /></a>
        <a class="btn btn-outline" href="/services.html" data-magnetic>Explore services</a>
      </div>
      <p class="live-chip" data-clock="America/New_York" data-shift data-stage>
        <i aria-hidden="true"></i>
        <span><span data-shift-lead>Live now:</span> <b data-time>US time</b> in New York</span>
        <span class="live-chip__state" data-shift-state>our team works US business hours</span>
      </p>
      <ul class="assure" aria-label="What every engagement includes">
        <li data-stage><span class="assure__icon"><Icon name="target" /></span><span><b>Agreed first</b><small>Requirements set before launch</small></span></li>
        <li data-stage><span class="assure__icon"><Icon name="clock" /></span><span><b>US hours</b><small>Staffed from Rawalpindi</small></span></li>
        <li data-stage><span class="assure__icon"><Icon name="lock" /></span><span><b>Secure</b><small>Private, protected records</small></span></li>
      </ul>
    </div>
    <div class="hero__art hero__art--intro" aria-hidden="true">
      <span class="halo"></span>
      <span class="ring r1"><i></i></span>
      <span class="ring r2"><i></i></span>
      <canvas class="emblem3d" data-emblem3d aria-hidden="true"></canvas>
      <div class="emblem-fallback"><Emblem caption={false} /></div>
    </div>
  </div>
  <div class="hero__foot">
    <div class="container">
      <div class="marquee" aria-hidden="true"><div class="marquee__track">{[0, 1].map(() => marquee.map((m) => <span>{m}<img class="marquee__mark" src="/assets/markforth-emblem.svg" alt="" width="445" height="430" loading="lazy" /></span>))}</div></div>
    </div>
  </div>
</section>
<div id="after-hero"></div>
